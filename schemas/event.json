{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptbasedtutorbrain.dev/schemas/event.json",
  "title": "Learning Event",
  "description": "One immutable, dated observation of something that happened. The append-only ledger record mandated by ADR-0002 and the referent of every source_event_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "student_id",
    "kind",
    "occurred_at",
    "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "minLength": 1 },
    "student_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },

    "kind": {
      "enum": [
        "session_started",
        "session_ended",
        "teaching_delivered",
        "retrieval_attempted",
        "answer_submitted",
        "answer_evaluated",
        "task_completed",
        "task_skipped",
        "plan_accepted",
        "plan_declined",
        "memory_committed",
        "revision_scheduled",
        "assumption_recorded"
      ]
    },

    "topic_id": { "type": "string", "minLength": 1 },

    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the observation happened, in the student's declared timezone offset."
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the system committed it. May differ from occurred_at on deferred writes."
    },

    "payload": {
      "type": "object",
      "description": "Kind-specific detail. Validated by the owning engine, not by this schema.",
      "additionalProperties": true
    },

    "produced_by": {
      "type": "object",
      "additionalProperties": false,
      "description": "Provenance of the process that generated this event. Required for auditability under ADR-0001.",
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "adapter_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },

    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "description": "Retry-safe identifier linking every event emitted by one orchestrated action."
    }
  }
}
