{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptbasedtutorbrain.dev/schemas/student.json",
  "title": "Student Profile", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "student_id", "profile_version", "exam_context", "availability", "topic_mastery"],
  "properties": {
    "schema_version": {"const": "1.0"}, "student_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "integer", "minimum": 1},
    "exam_context": {"type": "object", "additionalProperties": false, "required": ["exam", "target_year"], "properties": {"exam": {"type": "string", "minLength": 1}, "target_year": {"type": "integer", "minimum": 2020}}},
    "availability": {"type": "object", "additionalProperties": false, "required": ["timezone", "minutes_by_day"], "properties": {"timezone": {"type": "string", "minLength": 1}, "minutes_by_day": {"type": "object", "additionalProperties": false, "required": ["mon","tue","wed","thu","fri","sat","sun"], "properties": {"mon":{"type":"integer","minimum":0},"tue":{"type":"integer","minimum":0},"wed":{"type":"integer","minimum":0},"thu":{"type":"integer","minimum":0},"fri":{"type":"integer","minimum":0},"sat":{"type":"integer","minimum":0},"sun":{"type":"integer","minimum":0}}}}},
    "topic_mastery": {"type": "array", "items": {"type":"object","additionalProperties":false,"required":["topic_id","mastery","evidence_count","updated_at"],"properties":{"topic_id":{"type":"string","minLength":1},"mastery":{"type":"number","minimum":0,"maximum":1},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence_count":{"type":"integer","minimum":0},"updated_at":{"type":"string","format":"date-time"}}}},
    "preferences": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}}, "current_focus": {"type": "string"}
  }
}
