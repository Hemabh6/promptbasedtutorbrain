{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptbasedtutorbrain.dev/schemas/student.json",
  "title": "Student Profile",
  "description": "Current learner state. Authoritative for present state only; rebuildable from Memory. See docs/07 Student Model.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "student_id",
    "profile_version",
    "exam_context",
    "availability",
    "topic_mastery"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },

    "student_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque application identifier. Carries no demographic meaning."
    },

    "profile_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Optimistic concurrency token. A write against a stale value MUST be rejected."
    },

    "exam_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exam", "target_year", "stage"],
      "properties": {
        "exam": { "type": "string", "minLength": 1 },
        "target_year": { "type": "integer", "minimum": 2020 },
        "stage": { "enum": ["prelims", "mains", "interview"] },
        "attempt_number": {
          "type": "integer",
          "minimum": 1,
          "description": "Student-declared attempt count. Never inferred."
        },
        "optional_subject": { "type": "string", "minLength": 1 },
        "exam_date": {
          "type": "string",
          "format": "date",
          "description": "Drives exam.proximity_compression_days behaviour when known."
        }
      }
    },

    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "minutes_by_day"],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "description": "IANA timezone. All due-date computation uses this, never server-local time."
        },
        "minutes_by_day": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"],
          "properties": {
            "mon": { "type": "integer", "minimum": 0, "maximum": 1440 },
            "tue": { "type": "integer", "minimum": 0, "maximum": 1440 },
            "wed": { "type": "integer", "minimum": 0, "maximum": 1440 },
            "thu": { "type": "integer", "minimum": 0, "maximum": 1440 },
            "fri": { "type": "integer", "minimum": 0, "maximum": 1440 },
            "sat": { "type": "integer", "minimum": 0, "maximum": 1440 },
            "sun": { "type": "integer", "minimum": 0, "maximum": 1440 }
          }
        },
        "working_professional": {
          "type": "boolean",
          "description": "Affects plan shape and recovery reserve, not academic standards."
        },
        "blackout_dates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "date" }
        }
      }
    },

    "topic_mastery": {
      "type": "array",
      "description": "Evidence-backed mastery. Computed from retrieval and evaluation events; never self-reported.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic_id", "mastery", "evidence_count", "updated_at"],
        "properties": {
          "topic_id": { "type": "string", "minLength": 1 },
          "mastery": { "type": "number", "minimum": 0, "maximum": 1 },
          "self_reported_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Stored separately from mastery. The gap between them is a diagnostic signal."
          },
          "evidence_count": { "type": "integer", "minimum": 0 },
          "last_evidence_id": { "type": "string", "minLength": 1 },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    },

    "learning_style": {
      "type": "object",
      "additionalProperties": false,
      "description": "Presentation preferences only. MUST NOT alter rubric strictness or factual standards.",
      "properties": {
        "preferred_modality": { "enum": ["explanation", "example", "question", "diagram", "mixed"] },
        "pacing": { "enum": ["slow", "moderate", "fast"] },
        "feedback_tone": { "enum": ["direct", "supportive", "neutral"] },
        "example_density": { "enum": ["low", "medium", "high"] }
      }
    },

    "preferences": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] },
      "description": "Free-form presentation preferences. Never academic policy."
    },

    "constraints": {
      "type": "array",
      "description": "Consented, time-bounded limits on scheduling.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint_id", "kind", "description"],
        "properties": {
          "constraint_id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["time", "modality", "content", "accessibility", "workload"] },
          "description": { "type": "string", "minLength": 1 },
          "active_from": { "type": "string", "format": "date" },
          "active_until": { "type": "string", "format": "date" }
        }
      }
    },

    "current_focus": {
      "type": "string",
      "description": "Selected topic or goal. A statement of intent, never proof of coverage."
    },

    "derived": {
      "type": "object",
      "additionalProperties": false,
      "description": "Projections of topic_mastery and Memory. Recomputable, non-authoritative, MUST NOT be edited directly.",
      "properties": {
        "computed_at": { "type": "string", "format": "date-time" },
        "strengths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "topic_ids at or above student.mastery_strong_threshold."
        },
        "weaknesses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "topic_ids below student.mastery_weak_threshold."
        },
        "performance_metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan_adherence": { "type": "number", "minimum": 0, "maximum": 1 },
            "retrieval_success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "mean_rubric_score": { "type": "number", "minimum": 0, "maximum": 5 },
            "answers_evaluated": { "type": "integer", "minimum": 0 },
            "confidence_calibration_error": {
              "type": "number",
              "minimum": -1,
              "maximum": 1,
              "description": "Mean self_reported_confidence minus observed mastery. Positive indicates overconfidence."
            }
          }
        },
        "revision_summary": {
          "type": "object",
          "additionalProperties": false,
          "description": "Counters only. Revision history is owned by schemas/revision.json.",
          "properties": {
            "active_items": { "type": "integer", "minimum": 0 },
            "due_now": { "type": "integer", "minimum": 0 },
            "overdue_items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
