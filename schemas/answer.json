{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptbasedtutorbrain.dev/schemas/answer.json",
  "title": "Answer Evaluation",
  "description": "An immutable rubric evaluation of one submitted answer. Evidence, not state. See docs/06 Evaluation Engine.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "answer_id",
    "student_id",
    "question",
    "answer_text",
    "rubric_version",
    "dimensions",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "answer_id": { "type": "string", "minLength": 1 },
    "student_id": { "type": "string", "minLength": 1 },
    "topic_id": { "type": "string", "minLength": 1 },

    "question": { "type": "string", "minLength": 1 },
    "command_word": {
      "enum": [
        "discuss", "examine", "critically examine", "analyse", "evaluate",
        "comment", "elucidate", "illustrate", "justify", "explain", "describe"
      ],
      "description": "Drives the relevance dimension. MUST NOT be assumed when absent."
    },
    "word_limit": { "type": "integer", "minimum": 1 },

    "answer_text": {
      "type": "string",
      "minLength": 1,
      "description": "The student's original text, preserved verbatim. Never rewritten in place."
    },

    "rubric_version": {
      "type": "string",
      "minLength": 1,
      "description": "Scores under differing rubric versions MUST NOT be compared."
    },
    "prompt_version": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "format": "date-time" },

    "outline": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Neutral structural outline extracted before scoring, to prevent score-first rationalisation."
    },

    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "score", "evidence", "improvement"],
        "properties": {
          "name": {
            "enum": [
              "relevance", "coverage", "structure", "accuracy",
              "analysis", "evidence", "balance", "conclusion"
            ]
          },
          "score": { "type": "integer", "minimum": 0, "maximum": 5 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "Spans or precise paraphrases from answer_text. A dimension without evidence invalidates the record."
          },
          "improvement": { "type": "string", "minLength": 1 }
        }
      }
    },

    "total_score": {
      "type": "number",
      "minimum": 0,
      "description": "Computed by application code from configured weights. A model-supplied total is discarded."
    },

    "strengths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "omissions": { "type": "array", "items": { "type": "string", "minLength": 1 } },

    "unverified_claims": {
      "type": "array",
      "description": "Factual claims requiring verification. Labelled, never silently corrected.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "reason": { "enum": ["no_source", "conflicting_source", "outdated", "unclear"] }
        }
      }
    },

    "rewrite_plan": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Prioritised edits. Kept separate from answer_text so feedback is never mistaken for the submission."
    },

    "candidates": {
      "type": "array",
      "description": "Proposed follow-up work. Persistence requires approval by the owning engine.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "topic_id", "rationale"],
        "properties": {
          "kind": { "enum": ["practice", "revision", "teach"] },
          "topic_id": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
